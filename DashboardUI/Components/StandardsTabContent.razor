@using System
@using DashboardUI.Components.Exercises
@inject TabStatus TabState
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<section>
    <p class="fs-1 fw-bold my-2">Weightlifting Strength Standards</p>
    <p>
        Our strength standards help you understand how your performance compares with other lifters. 
        Choose an exercise to see where your one-rep max ranks among lifters of your gender, bodyweight and age.        
    </p>
</section>

<section>
    <p class="fs-4 fw-bold">By Exercise</p>

    <div class="p-3 bg-light rounded">

        @* Search box *@
        <div class="mb-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-secondary"></i>
                </span>
                <input type="text"
                       class="form-control border-start-0"
                       placeholder="Search..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @onkeyup="OnSearchChanged" />
            </div>
        </div>

        @* Filter dropdowns *@
        <div class="d-flex gap-2 flex-wrap">

            <div class="dropdown">
                <button class="btn btn-sm btn-white border dropdown-toggle bg-white"
                        type="button"
                        id="bodyPartDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    @(string.IsNullOrEmpty(SelectedBodyPart) ? "Any Body Part" : SelectedBodyPart)
                </button>
                <ul class="dropdown-menu" aria-labelledby="bodyPartDropdown">
                    <li><button class="dropdown-item" @onclick='() => SelectBodyPart("")'>Any Body Part</button></li>
                    @foreach (var part in Exercises)
                    {
                        <li><button class="dropdown-item" @onclick="() => SelectBodyPart(part.Name)">@part.Name</button></li>
                    }
                </ul>
            </div>

            <div class="dropdown">
                <button class="btn btn-sm btn-white border dropdown-toggle bg-white"
                        type="button"
                        id="categoryDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    @(string.IsNullOrEmpty(SelectedCategory) ? "Any Category" : SelectedCategory)
                </button>
                <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
                    <li><button class="dropdown-item" @onclick='() => SelectCategory("")'>Any Category</button></li>
                    @foreach (var cat in Categories)
                    {
                        <li><button class="dropdown-item" @onclick="() => SelectCategory(cat)">@cat</button></li>
                    }
                </ul>
            </div>
        </div>        
    </div>

    @* Exercise *@
    <div class="container p-2">
        <div class="row g-2">
            @foreach (var ex in Exercises)
            {
                <div class="col-3">
                    <button class="exebtn w-100 d-flex justify-content-center align-items-center fw-bold text-center rounded-2 p-3 bg-light" @onclick="() => OpenExercisePanal(ex.Name)" >
                        <img src="/assets/images/@ex.Image"
                             class="img-fluid me-2"
                             alt="@ex.Name" />
                        @ex.Name
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="container p-2">
        @if (componentType != null)
        {
            <DynamicComponent Type="componentType" />
        }
    </div>

</section>

@code {
    private Type? componentType;

    [Parameter] public EventCallback<string> OnSearchTextChanged { get; set; }
    [Parameter] public EventCallback<string> OnBodyPartChanged { get; set; }
    [Parameter] public EventCallback<string> OnCategoryChanged { get; set; }

    private string SearchText { get; set; } = string.Empty;
    private string SelectedBodyPart { get; set; } = string.Empty;
    private string SelectedCategory { get; set; } = string.Empty;

    // Replace with your real data source (injected service, parameter, etc.)
    private List<Exercise> Exercises { get; set; } = new()
    {
        new Exercise { Name = "Bench Press",     Image = "benchpress.webp" },
        new Exercise { Name = "Squat",           Image = "squat.webp" },
        new Exercise { Name = "Shoulder Press",  Image = "shoulderpress.webp" },
        new Exercise { Name = "Deadlift",        Image = "deadlift.webp" },
        new Exercise { Name = "Pull Ups",        Image = "pullups.webp" },
        new Exercise { Name = "Barbell Curl",    Image = "barbellcurl.webp" },
        new Exercise { Name = "Dumbbell Curl",   Image = "dumbbellcurl.webp" },
        new Exercise { Name = "Push Ups",        Image = "pushups.webp" },
        new Exercise { Name = "Leg Press",       Image = "legpress.webp" },
        new Exercise { Name = "Dips",            Image = "dips.webp" },
        new Exercise { Name = "Lateral Raises",Image = "lateralraises.webp" },
        new Exercise { Name = "Lat Pulldown",    Image = "latpulldown.webp" },
        new Exercise { Name = "Leg Extension",   Image = "legextension.webp" }
    };


    private List<string> Categories { get; set; } = new()
    {
        "Barbell", "Bodyweight", "Dumbbell", "Machine", "Cable"
    };

    private async Task OpenExercisePanal(string type)
    {
        try
        {
            var active = await JSRuntime.InvokeAsync<bool>("isTabActive", "#standardstab");
            TabState.SetStandardsActive(active);

            // Only assign if Standards tab is NOT active
            componentType = active ? type switch
            {
                "Bench Press" => typeof(BenchPress),
                "Squat" => typeof(Squat),
                "Shoulder Press" => typeof(ShoulderPress),
                "Deadlift" => typeof(Deadlift),
                _ => null
            } : null;
        }
        catch (Exception)
        {
            componentType = null;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }    

    private async Task OnSearchChanged(KeyboardEventArgs e)
    {
        await OnSearchTextChanged.InvokeAsync(SearchText);
    }

    private async Task SelectBodyPart(string part)
    {
        SelectedBodyPart = part;
        await OnBodyPartChanged.InvokeAsync(part);
    }

    private async Task SelectCategory(string cat)
    {
        SelectedCategory = cat;
        await OnCategoryChanged.InvokeAsync(cat);
    }

    public class Exercise
    {
        public string? Name { get; set; }
        public string? Image { get; set; }
    }
}
