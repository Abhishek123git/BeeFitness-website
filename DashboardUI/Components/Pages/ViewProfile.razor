@page "/viewprofile"
@rendermode InteractiveServer

<div class="container px-3">

    <div class="card text-white rounded-3 p-4 position-relative overflow-hidden" style="background-color:#5352ed;">
        <div class="d-flex justify-content-between align-items-start text-uppercase text-black fw-semibold font-plexmono">
            <span>Member ID · 0417-A</span>
            <span>Active</span>
        </div>
        <div class="d-flex align-items-center gap-3 mt-3">
            <div class="rounded-circle border border-warning p-1 flex-shrink-0 position-relative">
                <div class="d-flex align-items-center justify-content-center rounded-circle overflow-hidden bg-dark">                    
                    <svg width="70" height="70" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">                        
                        <circle cx="60" cy="48" r="20" fill="#9E9E9E" />
                        <path d="M60 74c-22 0-38 14-38 34a58 58 0 0076 0c0-20-16-34-38-34z" fill="#9E9E9E" />
                    </svg>
                </div>
            </div>
            <div>
                <h2 class="fw-bold fs-3 lh-sm">RIVERA, <span class="text-warning">JORDAN</span></h2>
                <p class="small text-white-50 mt-1 font-plexmono">Member since Mar 2024 · General fitness track</p>
            </div>
            <div class="ms-auto d-flex flex-column gap-2 align-items-end">                
                <button class="btn btn-outline-light btn-sm text-uppercase fw-bold fst-monospace rounded-pill py-2 px-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-trash3 fw-bold" viewBox="0 0 16 16">
                        <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                    </svg>
                    Remove
                </button>
            </div>
        </div>
    </div>

    <div class="tick-divider position-relative">
        <span class="position-absolute top-0 start-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-bar-chart me-1" viewBox="0 0 16 16">
                <path stroke="#ff7979" d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z" />
            </svg>
            Body stats
        </span>
    </div>

    <div class="row g-1  border rounded-3 overflow-hidden mb-2">
        <!-- Height -->
        <div class="col bg-white p-3">
            <div class="text-uppercase small text-muted mb-1 fw-bold font-plexmono">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#0d6efd" class="me-1" viewBox="0 0 16 16">
                    <path d="M8 0v16M4 4h8M4 12h8" stroke="#0d6efd" />
                </svg>
                Height
            </div>
            <div class="fs-4 fw-bold d-flex align-items-baseline">
                <input type="text" class="border-0 p-0 m-0 fw-bold fs-4" value="178" style="width:50px;" />
                <span class="fs-6 text-muted ms-1">cm</span>
            </div>
        </div>

        <!-- Weight -->
        <div class="col bg-white p-3 border border-top-0 border-bottom-0">
            <div class="text-uppercase small text-muted mb-1 fw-bold font-plexmono">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#198754" class="me-1" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="7" stroke="#198754" stroke-width="1.5" fill="none" />
                    <path d="M8 4v4l3 2" stroke="#198754" stroke-width="1.5" />
                </svg>
                Weight
            </div>
            <div class="fs-4 fw-bold d-flex align-items-baseline">
                <input type="text" class="border-0 p-0 m-0 fw-bold fs-4" value="74.5" style="width:60px;" />
                <span class="fs-6 text-muted ms-1">kg</span>
            </div>
        </div>

        <!-- Age -->
        <div class="col bg-white p-3">
            <div class="text-uppercase small text-muted mb-1 fw-bold font-plexmono">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#dc3545" class="me-1" viewBox="0 0 16 16">
                    <rect x="1" y="3" width="14" height="12" rx="2" ry="2" stroke="#dc3545" stroke-width="1.5" fill="none" />
                    <line x1="1" y1="6" x2="15" y2="6" stroke="#dc3545" stroke-width="1.5" />
                    <line x1="4" y1="1" x2="4" y2="4" stroke="#dc3545" stroke-width="1.5" />
                    <line x1="12" y1="1" x2="12" y2="4" stroke="#dc3545" stroke-width="1.5" />
                </svg>
                Age
            </div>
            <div class="fs-4 fw-bold d-flex align-items-baseline">
                <input type="text" class="border-0 p-0 m-0 fw-bold fs-4" value="29" style="width:40px;" />
                <span class="fs-6 text-muted ms-1">yrs</span>
            </div>
        </div>
    </div>


    <div class="tick-divider position-relative">
        <span class="position-absolute top-0 start-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-clipboard-data me-1" viewBox="0 0 16 16">
                <path stroke="#badc58" d="M4 11a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0zm6-4a1 1 0 1 1 2 0v5a1 1 0 1 1-2 0zM7 9a1 1 0 0 1 2 0v3a1 1 0 1 1-2 0z" />
                <path stroke="#badc58" d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                <path stroke="#badc58" d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z" />
            </svg>
            Identity
        </span>
    </div>

    <div class="card rounded-3 p-4 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-3">
                    <label class="form-label">First name</label>
                    <input type="text" value="Jordan" class="form-control" />
                </div>
                <div class="col-3">
                    <label class="form-label">Last name</label>
                    <input type="text" value="Rivera" class="form-control" />
                </div>
                <div class="col-3">
                    <label class="form-label">Email</label>
                    <input type="email" value="jordan.rivera@example.com" class="form-control" />
                </div>
                <div class="col-3">
                    <label class="form-label">Phone</label>
                    <input type="tel" placeholder="Optional" class="form-control" />
                </div>
                <div class="col-3">
                    <label class="form-label">Date of birth</label>
                    <input type="date" value="1996-04-17" class="form-control" />
                </div>
                <div class="col-3">
                    <label class="form-label">Gender</label>
                    <select class="form-control">
                        <option>Male</option>
                        <option>Female</option>
                        <option>Prefer not to say</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="tick-divider position-relative">
        <span class="position-absolute top-0 start-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 viewBox="0 0 24 24" fill="none" stroke="#0d6efd" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <!-- Outer circle (target) -->
                <circle cx="12" cy="12" r="10" stroke="#0d6efd" fill="none" />
                <!-- Inner circle -->
                <circle cx="12" cy="12" r="4" stroke="#0d6efd" fill="none" />
                <!-- Arrow -->
                <line x1="19" y1="5" x2="12" y2="12" />
                <polyline points="19 5 15 5 15 9" />
            </svg>
            Goals
        </span>
    </div>

    <div class="card rounded-3 p-4 mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <div class="chip badge rounded-pill bg-light text-secondary">Weight loss</div>
                <div class="chip badge rounded-pill bg-dark text-warning fw-semibold">General fitness</div>
                <div class="chip badge rounded-pill bg-light text-secondary">Muscle gain</div>
                <div class="chip badge rounded-pill bg-light text-secondary">Endurance</div>
                <div class="chip badge rounded-pill bg-light text-secondary">Flexibility</div>
            </div>
        </div>
    </div>

    <div class="tick-divider position-relative">
        <span class="position-absolute top-0 start-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-file-person-fill me-1" viewBox="0 0 16 16">
                <path stroke="#686de0" d="M12 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2m-1 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0m-3 4c2.623 0 4.146.826 5 1.755V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1.245C3.854 11.825 5.377 11 8 11" />
            </svg>
            About
        </span>
    </div>

    <div class="card rounded-3 px-4 py-1 mb-3">
        <div class="card-body">
            <div class="col">
                <label id="lblbio" class="mb-1 font-plexmono">Bio</label>
                <textarea class="form-control"
                          value="@bioText"
                          @oninput="OnInput"  
                          @onkeypress="HandleKeyPress"
                          placeholder="Tell us a bit about your fitness journey...">
                </textarea>
                <small class="text-muted align-self-end mt-1 d-flex justify-content-end">@charCount/@MaxLength</small>
            </div>
        </div>
    </div>


    <div class="d-flex justify-content-end gap-2 mt-2">
        <button class="btn btn-outline-secondary btn-sm fw-semibold rounded-pill">Cancel</button>
        <button class="btn btn-warning fw-bold rounded-pill">Save changes</button>
    </div>

</div>

<script>
    document.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
        chip.classList.add('selected');
      });
    });
</script>

@code {
    private string bioText = "";
    private int charCount = 0;    
    private const int MaxLength = 10;

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private void OnInput(ChangeEventArgs e)
    {
        string newValue = e.Value?.ToString() ?? "";
        bioText = newValue.Length > MaxLength
            ? newValue.Substring(0, MaxLength)
            : newValue;
        charCount = bioText.Length;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        await JSRuntime.InvokeVoidAsync("blockKeyPress", e, MaxLength, bioText.Length);
    }
}
