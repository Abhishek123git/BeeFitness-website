@page "/"

@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<section class="hero min-vh-100 d-flex align-items-center text-white position-relative">
    <div class="container text-center py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h1 class="hero-heading fw-bolder lh-sm mb-4">
                    Crush your health and<br class="d-none d-md-block" />
                    fitness goals in no time
                </h1>

                <p class="hero-subtext mx-auto mb-4 fs-5 text-white-50">
                    It doesn't matter if your goal is to get stronger, burn fat, or to just stay fit
                    our world class coaches will guide you every step of the way.
                </p>

                <button class="btn btn-cta fw-semibold px-4 py-3 rounded-pill border-0 mb-5" @onclick="OnStartTrialClicked">
                    Start 7 day free trial
                </button>

                <div class="d-flex flex-column align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="stars">★★★★★</span>
                        <span class="review-count">@ReviewCount</span>
                        <span class="review-label">five star reviews</span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <img src="@TestimonialAvatarUrl" class="testimonial-avatar" alt="Reviewer" />
                        <p class="testimonial-text mb-0 text-start">
                            "@TestimonialText"
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>    
</section>
<section class="d-grid justify-content-center text-center my-5">
    <p class="fs-4 fw-bold">AT-CENTER</p>
    <p class="fs-1 fw-bold">Trainer-led group classes</p>

    <div class="card card-strength" onclick="window.open('#strength','_self')">
        <div class="card-content">                                    
            <div class="card-btn">
                EXPLORE
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </div>
        </div>
    </div>

</section>

@code {
    /// <summary>
    /// Number of five-star reviews to display in the badge.
    /// </summary>
    [Parameter]
    public int ReviewCount { get; set; } = 83;

    /// <summary>
    /// Testimonial quote shown next to the reviewer avatar.
    /// </summary>
    [Parameter]
    public string TestimonialText { get; set; } = "6 months after joining I lost 15lbs and I'm getting stronger.";

    /// <summary>
    /// URL of the testimonial reviewer's avatar image.
    /// </summary>
    [Parameter]
    public string TestimonialAvatarUrl { get; set; } = "https://randomuser.me/api/portraits/men/32.jpg";

    /// <summary>
    /// Callback fired when the CTA button is clicked. Wire this up to
    /// navigation, a modal, or a signup flow from the parent component.
    /// </summary>
    [Parameter]
    public EventCallback OnStartTrial { get; set; }

    private async Task OnStartTrialClicked()
    {
        if (OnStartTrial.HasDelegate)
        {
            await OnStartTrial.InvokeAsync();
        }
    }
}
