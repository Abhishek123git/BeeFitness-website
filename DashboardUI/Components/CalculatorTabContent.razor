@using DashboardUI.Components.Calculators
@inject TabStatus TabState
@inject IJSRuntime JSRuntime


<div class="bg-light rounded p-4">
    @if (ActiveTab == "Calculator")
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var tool in CalculatorTools)
            {
                <div class="col">
                    <button type="button"
                            class="@CardClass(tool)"
                            @onclick="() => OpenCalculator(tool.Key)"
                            aria-pressed="@(tool.Key == activeKey)">
                            <span class="hive-card__icon d-grid flex-shrink-0 rounded p-2 fs-5" style="--icon-tint: @(tool.Tint);">
                                <i class="bi @tool.Icon"></i>
                            </span>
                            <span class="flex-grow-1 fw-semibold fs-6 lh-sm">@tool.Name</span>
                            <i class="bi bi-chevron-right hive-card__chevron flex-shrink-0 fs-6"></i>
                    </button>
                </div>
            }
            
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center gap-3 py-custom text-dark font-body">
            <i class="bi bi-box fs-1 text-violet"></i>
            <p class="m-0">
                @(ActiveTab == "Standards"
                                ? "Strength standards are being calibrated. Check back soon."
                                : "Workout builder tools are being calibrated. Check back soon.")
            </p>
        </div>
    }
</div>

@if (componentType != null)
{
    <div class="hive-calc-panel position-relative mt-4 bg-white border rounded" id="hiveCalcPanel">
        <DynamicComponent Type="componentType" />
    </div>
}

@code {
    private string ActiveTab = "Calculator";
    private Type? componentType;
    private string? activeKey;   
    
    private string CardClass(Tool tool) =>
    tool.Key == activeKey ? "hive-card d-flex align-items-center gap-3 w-100 h-100 bg-white border rounded p-3 text-start cursor-pointer hive-card--active" : "hive-card d-flex align-items-center gap-3 w-100 h-100 bg-white border rounded p-3 text-start cursor-pointer";

    private static readonly Dictionary<string, Type> CalculatorComponents = new()
    {
        ["BMI"] = typeof(BMICalculator),
        ["Strength"] = typeof(StrengthCalculator),
        ["BMR"] = typeof(BMRCalculator),
        ["Protein"] = typeof(ProteinCalculator),                
        ["Fat"] = typeof(FatPercentageCalculator),
    };

    private async Task OpenCalculator(string key)
    {       
        if (activeKey == key && componentType != null)
        {
            CloseCalculator();
            return;
        }
        
        componentType = null;
        activeKey = key;
        StateHasChanged();

        try
        {
            var standardsActive = await JSRuntime.InvokeAsync<bool>("isTabActive", "#standardstab");
            TabState.SetStandardsActive(standardsActive);

            if (standardsActive)
            {
                componentType = null;
            }
            if (CalculatorComponents.TryGetValue(key, out var type))
            {
                componentType = type;
            }            
        }
        catch (JSException)
        {
            // JS interop unavailable (e.g. prerendering) — fall back to showing the calculator anyway
            if (CalculatorComponents != null && CalculatorComponents.TryGetValue(key, out var type))
            {
                componentType = type;
            }            
        }
        finally
        {           
            await InvokeAsync(StateHasChanged);
            if (componentType != null)
            {
                await JSRuntime.InvokeVoidAsync("hiveScrollIntoView", "#hiveCalcPanel");
            }
        }
    }

    private void CloseCalculator()
    {
        componentType = null;
        activeKey = null;       
    }

    private record Tool(string Name, string Key, string Icon, string Href, string Tint);

    private readonly List<Tool> CalculatorTools = new()
    {
        new("BMI (Body Mass Index) Calculator",             "BMI",      "bi-rulers",         "/tools/bmi",            "#5B4FE9"),
        new("Bench Press Calculator: Your 1 REP MAX (1RM)", "Bench",    "bi-bar-chart-fill", "/tools/bench-press",    "#FF7A1A"),
        new("BMR (Basal Metabolic Rate) Calculator",        "BMR",      "bi-fire",           "/tools/bmr",             "#FF5A5F"),
        new("Wilks Calculator (Wilks Coefficient)",         "Wilks",    "bi-award-fill",     "/tools/wilks",           "#2FA98C"),
        new("Strength Level Calculator",                    "Strength", "bi-lightning-fill", "/tools/strength-level",  "#2FA98C"),
        new("Protein Calculator",                           "Protein",  "bi-egg-fried",      "/tools/protein",         "#2E86DE"),
        new("Fat Percentage Calculator",                    "Fat",  "bi bi-percent",      "/tools/fatpercent",  "#f1c40f"),
    };
}